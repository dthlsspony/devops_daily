# ---------------------------------------------------------------------------
# Обязательные переменные. Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID канала (например -1001234567890) или чата
TELEGRAM_CHANNEL_ID=-1001234567890

# Ключ авторизации GigaChat (base64). Freemium-ключ выдаётся в личном кабинете.
GIGACHAT_CREDENTIALS=REPLACE_WITH_BASE64_KEY

# ---------------------------------------------------------------------------
# GigaChat
# ---------------------------------------------------------------------------

# Модель GigaChat. Freemium-тариф поддерживает GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-2-Max

# Проверка TLS к GigaChat. OAuth-сервер GigaChat работает на сертификате
# Минцифры (Russian Trusted Root CA); нужный корень уже встроен в пакет.
# false — отключить проверку. Не рекомендуется: ключ GigaChat уйдёт по
# непроверенному соединению.
GIGACHAT_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Расписание и ограничения объёма
# ---------------------------------------------------------------------------

# Минимальное число отобранных новостей, иначе цикл пропускается
MIN_NEWS_THRESHOLD=2

# Период запуска цикла, часов. Первый цикл выполняется сразу после старта.
SCHEDULE_HOURS=4

# Сколько последних записей брать из одной ленты
MAX_ITEMS_PER_FEED=50

# Новости старше этого числа дней в дайджест не попадают (0 — без ограничения)
MAX_ITEM_AGE_DAYS=3

# Максимум новостей в одном посте (одном теге); остальные дождутся следующего
# цикла (0 — без ограничения)
MAX_ITEMS_PER_TAG=15

# Максимум постов за цикл — столько же вызовов GigaChat. Теги, не попавшие
# в лимит, публикуются в следующих циклах (0 — без ограничения)
MAX_POSTS_PER_CYCLE=5

# Минимум новостей в посте. Если в теге меньше — тег ждёт следующего цикла
MIN_ITEMS_PER_TAG=1

# ---------------------------------------------------------------------------
# Состояние. Внутри контейнера ./data — это каталог ./data проекта.
# ---------------------------------------------------------------------------

# База дедупликации
DB_PATH=./data/seen.sqlite

# Отдельная база для dry-run: пробные прогоны не влияют на рабочее состояние
DRY_RUN_DB_PATH=./data/seen.dry-run.sqlite

# Куда собирается CA-bundle для GigaChat (стандартные корни + Минцифры)
CA_BUNDLE_PATH=./data/ca-bundle.pem

# Отметка времени последнего цикла для /healthz
HEARTBEAT_PATH=./data/heartbeat.json

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Сеть
# ---------------------------------------------------------------------------

# Таймаут сетевых запросов, секунд
REQUEST_TIMEOUT=20

# Лимит длины сообщения Telegram (в UTF-16 кодовых единицах)
TELEGRAM_MAX_MESSAGE_LENGTH=4096

# Пауза между частями длинного сообщения, секунд
TELEGRAM_RATE_LIMIT_DELAY=1.0

# ---------------------------------------------------------------------------
# Healthcheck
# ---------------------------------------------------------------------------

# Порт на хосте, куда пробрасывается /healthz контейнера
HEALTH_PORT=8080

# Сколько секунд heartbeat считается свежим. По умолчанию: SCHEDULE_HOURS + 15 минут
# (между циклами отметка не обновляется). Раскомментируйте, чтобы задать явно.
# HEARTBEAT_MAX_AGE_SECONDS=900

# ---------------------------------------------------------------------------
# JSON-массивы (необязательно) — переопределение фидов, ключевых слов и
# правил тегирования.
#
# Пример FEEDS: [{"source":"nginx","url":"https://example.com/feed.xml","trusted":false}]
# Пример TAG_RULES: [{"tag":"php","keywords":["php","composer"],"sources":["php.net"]}]
# Порядок правил = приоритет: отличительный тип события → стек → общий тип.
# ---------------------------------------------------------------------------
# FEEDS=[]
# KEYWORDS=["cve","rce","vulnerability","exploit","malware"]
# TAG_RULES=[]
